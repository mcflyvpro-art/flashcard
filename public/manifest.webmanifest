{
  "name": "Mirandola",
  "short_name": "Mirandola",
  "id": "/",
  "start_url": "/app",
  "scope": "/",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://mirandola.fr/manifest.webmanifest"
    }
  ],
  "display": "standalone",
  "background_color": "#F6F5F1",
  "theme_color": "#F6F5F1",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "description": "Tes cours, reliés en livres. Fiches de révision, récitation et étagère partagée.",
  "screenshots": [
    {
      "src": "shots/wide.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "shots/narrow.png",
      "sizes": "414x896",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],
  "shortcuts": [
    {
      "name": "Lire maintenant",
      "short_name": "Lire",
      "description": "Ouvre les fiches du jour, toute la bibliothèque confondue.",
      "url": "/app?go=study",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Nouveau livre",
      "short_name": "Écrire",
      "description": "Crée un livre et ouvre sa première fiche.",
      "url": "/app?go=new",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Courrier",
      "short_name": "Courrier",
      "description": "Les livres qu’on t’a prêtés.",
      "url": "/app?go=mail",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
